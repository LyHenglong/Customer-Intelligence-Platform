# Secrets / env
.env
*.env
kaggle.json

# Data (raw batches and DuckDB files are regenerated, not versioned)
data/raw/*.csv
data/raw_download/
# Third-party Kaggle data, downloaded on first run by
# src/model/train_churn_telco.py - not ours to redistribute, same as above.
data/raw_telco/
data/processed/
*.duckdb
*.duckdb.wal

# Model artifacts (versioned separately, not in git)
models_store/*.pkl
models_store/*.joblib
models_store/*.json
!models_store/.gitkeep

# MLflow artifact store (docker-compose's mlflow service bind mount) -
# bookkeeping copies of the same artifacts already excluded above.
mlflow_artifacts/

# Postgres backup dumps (dags/backup_warehouse.py) - regenerated daily,
# never versioned (and would contain real customer data).
backups/*.sql.gz
!backups/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Airflow
logs/
airflow.db
airflow-webserver.pid
docker/airflow_logs/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Postgres data volume mount (if bind-mounted locally)
docker/pgdata/
neon_migration.sql

# Auto-generated by the Next.js dev server on every run (next.config
# agentRules) - tooling output, not authored source.
frontend/AGENTS.md
frontend/CLAUDE.md
