# Secrets / env
.env
*.env
kaggle.json

# Data (raw batches and DuckDB files are regenerated, not versioned)
data/raw/*.csv
data/raw_download/
data/processed/
*.duckdb
*.duckdb.wal

# Model artifacts (versioned separately, not in git)
models_store/*.pkl
models_store/*.joblib
models_store/*.json
!models_store/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Airflow
logs/
airflow.db
airflow-webserver.pid
docker/airflow_logs/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Postgres data volume mount (if bind-mounted locally)
docker/pgdata/
neon_migration.sql

# Streamlit Community Cloud secrets - never commit real credentials
.streamlit/secrets.toml
