# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (warehouse + Airflow metadata) ---
POSTGRES_USER=telecom_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=warehouse
# "localhost" for scripts run on the host machine (dbt, ingestion, training,
# API when run outside Docker) - the Postgres container publishes 5432 to
# the host. Inside docker-compose, the airflow/api services override this
# to "postgres" (the service name) automatically.
# NOTE: mapped to 5433 on the host in docker-compose.yml, to avoid clashing
# with any pre-existing local Postgres install on the default 5432. Adjust
# if 5433 is also taken on your machine (keep this in sync with the
# "5433:5432" port mapping under the postgres service).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# "prefer": negotiates SSL when the server offers it, plaintext otherwise -
# works unchanged against local Docker Postgres (no SSL) and a hosted
# provider like Neon (SSL required). Leave as "prefer" unless connecting to
# a provider that requires "require"/"verify-full".
POSTGRES_SSLMODE=prefer

# Separate database on the same Postgres instance, used only for Airflow's
# own metadata (task history, DAG state) - keeps it isolated from the
# warehouse tables that dbt/ML code reads and writes.
AIRFLOW_DB=airflow_meta

# Separate database on the same Postgres instance, used only for MLflow's
# tracking/registry backend store (src/model/registry.py, docker-compose's
# mlflow service) - kept isolated from both the warehouse and Airflow's
# own metadata database.
MLFLOW_DB=mlflow_meta
# "http://mlflow:5000" inside docker-compose (the airflow/api services
# override this automatically, same pattern as POSTGRES_HOST).
# This value (http://localhost:5001) is for scripts run on the host
# machine - the mlflow service publishes 5001 -> 5000 to the host. Unset
# entirely to disable registry lookups: every caller falls back to the
# existing glob-latest-by-timestamp behavior (see registry.py).
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW__WEBSERVER__SECRET_KEY=replace_with_generated_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Retraining trigger ---
RETRAIN_EVERY_N_BATCHES=3

# --- Backups (dags/backup_warehouse.py, self-hosted Postgres only) ---
# Skips itself automatically against a hosted provider like Neon (which
# already backs itself up) - see that DAG's own docstring. How many days
# of local dumps to keep in ./backups/ before pruning older ones.
BACKUP_RETENTION_DAYS=14

# --- AI Agent Layer (src/agents/) ---
# Optional: powers plain-English churn explanations, drafted retention
# outreach, and retrain summaries (see README's "AI Agent Layer" section).
# Every other feature in this project works without it - agents fall back
# to showing the raw SHAP values / metrics they'd otherwise narrate.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional: least-privilege Postgres role for the AI assistant's SQL tool
# (created by db/ai_readonly_role.sql). Unset means the tool connects with
# POSTGRES_USER above - still validated and read-only, but without the
# database itself enforcing the table allowlist.
AI_SQL_POSTGRES_USER=
AI_SQL_POSTGRES_PASSWORD=

# --- TLS reverse proxy (docker/Caddyfile, "production" compose profile) ---
# Only needed if self-hosting this stack directly (docker compose --profile
# production up -d caddy) with a real domain instead of deploying to a
# platform that already provides TLS (Render provides it automatically -
# see render.yaml). Leave unset otherwise. Each must be a real domain/
# subdomain with a DNS A record already pointing at this host's public IP.
API_DOMAIN=
FRONTEND_DOMAIN=

# --- Alerting (src/monitoring/alerting.py) ---
# Optional: posts to Slack when a batch shows significant feature drift
# or an Airflow task exhausts its retries (see dags/churn_pipeline.py).
# Unset means alerts are silently skipped - nothing else in the platform
# depends on this. Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# --- Next.js frontend (frontend/) ---
# The frontend's own browser-facing origin(s) - required for the api
# service to accept cross-origin requests from it (a browser fetch from a
# different port/host is a different origin). Comma-separated for
# multiple (e.g. a deployed URL alongside localhost during development).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: call the API straight from the browser instead of through the
# frontend's server-side proxy (frontend/app/api/backend/). Baked into the
# browser bundle at BUILD time, and only works while API_KEYS is unset.
# Leave empty to use the proxy.
NEXT_PUBLIC_API_URL=

# --- API auth & rate limiting (src/api/security.py) ---
# Comma-separated keys; when set, every API route except /health requires
# an X-API-Key header. Empty disables auth (fine for local dev).
API_KEYS=
# The key the frontend's proxy sends - must be one of API_KEYS.
API_KEY=
# Per-client limit on the endpoints that can call the LLM.
LLM_RATE_LIMIT_PER_MINUTE=10
