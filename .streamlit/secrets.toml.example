# Template for Streamlit Community Cloud's "Secrets" UI (App settings ->
# Secrets) - NOT read from disk in production, Streamlit Cloud injects
# these into st.secrets, which src/dashboard/app.py bridges into
# os.environ at import time (see the comment there). Copy the keys below
# into that UI with your real Neon connection details; never commit a
# real secrets.toml (this repo's .gitignore already excludes secrets.toml,
# only this .example file is tracked).

POSTGRES_HOST = "ep-xxxxx-pooler.region.aws.neon.tech"
POSTGRES_PORT = "5432"
POSTGRES_DB = "neondb"
POSTGRES_USER = "your_neon_user"
POSTGRES_PASSWORD = "your_neon_password"
POSTGRES_SSLMODE = "require"

# Optional - the AI Agent Layer's explanation/outreach features. Omit
# entirely for a public demo unless you want visitors able to trigger
# real (rate-limited, cost-bearing) calls against your own Groq quota -
# see the README's AI Agent Layer section for the guardrails in place
# either way (opt-in button, capped to 15 customers, cached).
# GROQ_API_KEY = "gsk_..."
