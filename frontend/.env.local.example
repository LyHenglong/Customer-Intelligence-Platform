# Copy to .env.local for local dev (gitignored by create-next-app's default .gitignore).

# Read at runtime by the server-side proxy route (app/api/backend/) - the
# browser never sees these.
API_URL=http://localhost:8000
# Must match one of the API's API_KEYS, if it has any configured.
API_KEY=

# Optional: call the API directly from the browser instead of through the
# proxy. Build-time-inlined into the bundle; only works when the API has no
# API_KEYS set. Leave unset to use the proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
