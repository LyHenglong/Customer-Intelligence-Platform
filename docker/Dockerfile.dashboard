FROM python:3.11-slim

WORKDIR /app

# libgomp1: LightGBM's native library dlopen()s libgomp.so.1 (GNU OpenMP)
# at import time (pulled in via src.model.train_churn); python:3.11-slim
# doesn't include it by default.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# requirements-streamlit-cloud.txt, not requirements.txt: the trimmed set
# already proven correct for this exact import surface (verified by tracing
# app.py's full import chain for the separate Streamlit Community Cloud
# deploy) - the dashboard calls the API service over HTTP via stdlib
# urllib (see call_assistant_api() in app.py), so it never needs
# dbt-core/dbt-postgres, kaggle, sentence-transformers/torch, or
# fastapi/uvicorn/pydantic, all of which requirements.txt pulls in.
COPY requirements-streamlit-cloud.txt requirements.txt
# --default-timeout=300 --retries 15: pip's default 15s per-read socket
# timeout is too aggressive for a slow-but-working connection - see
# docker/Dockerfile.api's comment for the real ReadTimeoutError this
# was found from.
RUN pip install --no-cache-dir --default-timeout=300 --retries 15 -r requirements.txt

COPY src/__init__.py /app/src/__init__.py
COPY src/warehouse.py /app/src/warehouse.py
COPY src/model /app/src/model
COPY src/agents /app/src/agents
COPY src/dashboard /app/src/dashboard
COPY models_store /app/models_store

# Non-root: the dashboard only ever reads models_store (never writes), so
# no host-side chmod/chown is needed on that bind mount for this user to work.
RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3)" || exit 1
CMD ["streamlit", "run", "src/dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
