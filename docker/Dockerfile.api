FROM python:3.11-slim

WORKDIR /app

# libgomp1: LightGBM's native library dlopen()s libgomp.so.1 (GNU OpenMP)
# at import time; python:3.11-slim doesn't include it by default.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch build, installed before requirements.txt: sentence-
# transformers (src/ai/rag/embeddings.py, .../reranker.py) depends on
# torch but doesn't pin which build, so a plain `pip install -r
# requirements.txt` resolves PyPI's default wheel - which bundles full
# CUDA support (multiple GB) even though this container has no GPU and
# never uses one. Installing the CPU-only wheel first (~200MB) satisfies
# that dependency before pip ever considers the CUDA build.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/__init__.py /app/src/__init__.py
COPY src/warehouse.py /app/src/warehouse.py
COPY src/model /app/src/model
COPY src/agents /app/src/agents
COPY src/ai /app/src/ai
COPY models_store /app/models_store
COPY knowledge /app/knowledge

EXPOSE 8000
CMD ["uvicorn", "src.model.api:app", "--host", "0.0.0.0", "--port", "8000"]
