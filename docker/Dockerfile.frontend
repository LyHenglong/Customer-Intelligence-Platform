# Multi-stage build -> a lean runtime image via Next.js's `output:
# "standalone"` (see frontend/next.config.ts): only the traced production
# dependencies + .next/static + public get copied into the final stage,
# not the full node_modules from the build stage.
FROM node:20-slim AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:20-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .
# NEXT_PUBLIC_API_URL is inlined into the browser bundle at BUILD time,
# not read at container runtime - see lib/api-client.ts's comment. Must
# be passed as a --build-arg (docker-compose.yml's build.args, or
# Render's build-time env), not just a runtime environment variable -
# setting it only at `docker run` time has no effect on an already-built
# bundle.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# node:20-slim already ships a non-root "node" user at UID 1000 (that's
# the whole reason official node images include one) - reuse it instead
# of useradd'ing a second one, which collides on that same UID.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://localhost:3000').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "server.js"]
