FROM apache/airflow:2.10.3-python3.11

USER root
# libgomp1: LightGBM's native library dlopen()s libgomp.so.1 (GNU OpenMP)
# at import time; not guaranteed present without an explicit install.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow
COPY docker/requirements-airflow.txt /tmp/requirements-airflow.txt
# --default-timeout=300 --retries 15: pip's default 15s per-read socket
# timeout is too aggressive for a slow-but-working connection - see
# docker/Dockerfile.api's comment for the real ReadTimeoutError this
# was found from.
RUN pip install --no-cache-dir --default-timeout=300 --retries 15 -r /tmp/requirements-airflow.txt

# dbt project lives on a mounted volume at /opt/airflow/dbt (see docker-compose.yml)
